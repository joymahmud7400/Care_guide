# Optional Google OAuth 2.0 web client. Keep the client secret private.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Enable true only if serving through HTTPS. Local LedgerLens defaults to HTTP on loopback.
COOKIE_SECURE=false

# Set false to hide account creation and reject new registrations.
ALLOW_SIGNUP=true
